# =============================================================================
# Car Rental SaaS - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (server-side only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# Supabase Auth Configuration
# Configure in Supabase Dashboard > Authentication > URL Configuration
# -----------------------------------------------------------------------------
# Site URL - The base URL of your application
# Set this in Supabase Dashboard: https://supabase.com/dashboard/project/_/auth/url-configuration
# Development: http://localhost:3000
# Production: https://yourdomain.com

# Redirect URLs (add these to Supabase Dashboard > Authentication > URL Configuration > Redirect URLs)
# Development:
#   - http://localhost:3000/api/auth/callback
#   - http://localhost:3000/[locale]/auth/callback (for each locale: en, lt, ru)
# Production:
#   - https://yourdomain.com/api/auth/callback
#   - https://*.yourdomain.com/api/auth/callback (wildcard for multi-tenant)

# Auth callback URL (used in auth flows)
NEXT_PUBLIC_AUTH_CALLBACK_URL=/api/auth/callback

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Car Rental SaaS

# -----------------------------------------------------------------------------
# Stripe Configuration (for payments)
# Get these from: https://dashboard.stripe.com/apikeys
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your-secret-key-here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# -----------------------------------------------------------------------------
# Email Configuration (Resend)
# Get API key from: https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_your-api-key-here
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Car Rental

# Debug mode - logs emails to console instead of sending in development
# EMAIL_DEBUG=true

# -----------------------------------------------------------------------------
# Platform Settings
# -----------------------------------------------------------------------------
# Default locale for the application
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Supported locales (comma-separated)
NEXT_PUBLIC_SUPPORTED_LOCALES=en,lt,ru

# -----------------------------------------------------------------------------
# Vercel Deployment Configuration
# -----------------------------------------------------------------------------
# These are automatically set by Vercel, but documented here for reference:
# VERCEL_URL - The URL of the deployment (auto-set)
# VERCEL_ENV - The environment (production, preview, development)
# VERCEL_GIT_COMMIT_SHA - Git commit SHA (auto-set)

# Cron job secret for securing cron endpoints
CRON_SECRET=your-cron-secret-here

# -----------------------------------------------------------------------------
# Multi-Tenant Domain Configuration
# -----------------------------------------------------------------------------
# Base domain for tenant subdomains (e.g., yourdomain.com)
# Tenants will be accessible at: {tenant-slug}.yourdomain.com
NEXT_PUBLIC_BASE_DOMAIN=localhost:3000

# Wildcard domain for multi-tenant routing (production)
# Configure in Vercel: *.yourdomain.com
# NEXT_PUBLIC_BASE_DOMAIN=yourdomain.com

# -----------------------------------------------------------------------------
# Google Maps / Mapbox (for location features)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key
# NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token

# -----------------------------------------------------------------------------
# Analytics & Performance Monitoring
# -----------------------------------------------------------------------------
# Vercel Analytics - Automatically enabled when deployed to Vercel
# No configuration needed - works out of the box with @vercel/analytics
# Dashboard: https://vercel.com/[team]/[project]/analytics

# Vercel Speed Insights - Core Web Vitals monitoring
# Automatically enabled when deployed to Vercel
# No configuration needed - works out of the box with @vercel/speed-insights
# Dashboard: https://vercel.com/[team]/[project]/speed-insights

# Optional: Custom analytics endpoint for Web Vitals reporting
# NEXT_PUBLIC_VITALS_ENDPOINT=/api/analytics/vitals

# Optional: Google Analytics 4
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Debug mode for analytics (logs to console in development)
# NEXT_PUBLIC_ANALYTICS_DEBUG=true
